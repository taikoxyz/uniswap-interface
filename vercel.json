{
  "buildCommand": "yarn build",
  "devCommand": "yarn start",
  "installCommand": "yarn install --ignore-engines --network-timeout 100000",
  "framework": null,
  "outputDirectory": "build",
  "env": {
    "NODE_VERSION": "20.x"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(fonts|images|nft)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/((?!static/|fonts/|images/|nft/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
